+// static
+bool ThreadIsolation::SetPermissionsOnAllJitPages(
+    PageAllocator::Permission permission) {
+  // Several Wasm compilation workers may hold outer write scopes at once.
+  // Restore RX only after the last writer has finished.
+  static base::Mutex scope_mutex;
+  static size_t active_writers = 0;
+  base::MutexGuard scopes(&scope_mutex);
+  if (permission == PageAllocator::Permission::kReadWrite) {
+    if (active_writers++ != 0) return true;
+  } else {
+    CHECK_EQ(permission, PageAllocator::Permission::kReadExecute);
+    CHECK_GT(active_writers, 0);
+    if (--active_writers != 0) return true;
+  }
+  if (!trusted_data_.jit_pages_mutex_) return true;
+  base::MutexGuard guard(trusted_data_.jit_pages_mutex_);
+  PageAllocator* allocator = GetPlatformPageAllocator();
+  const size_t page_size = allocator->AllocatePageSize();
+  for (const auto& entry : *trusted_data_.jit_pages_) {
+    JitPageReference page(entry.second, entry.first);
+    const Address start = RoundDown(page.Address(), page_size);
+    const Address end = RoundUp(page.End(), page_size);
+    if (!allocator->SetPermissions(reinterpret_cast<void*>(start), end - start,
+                                   permission)) {
+      return false;
+    }
+  }
+  return true;
+}
