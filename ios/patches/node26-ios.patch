+"""Keep host and iOS Temporal static libraries in separate target directories."""
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+
+toolset, intermediate, build_type, target_os = sys.argv[1:]
+target_dir = Path(intermediate).resolve() / ('crates-' + toolset)
+args = [os.environ.get('CARGO', 'cargo'), 'rustc', '--frozen', '--target-dir', str(target_dir)]
+profile = 'release' if build_type == 'Release' else 'debug'
+if profile == 'release':
+    args.append('--release')
+triple = 'aarch64-apple-ios' if target_os == 'ios' and toolset == 'target' else None
+if triple:
+    args += ['--target', triple]
+subprocess.run(args, check=True)
+if triple:
+    destination = target_dir / profile / 'libnode_crates.a'
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    shutil.copy2(target_dir / triple / profile / 'libnode_crates.a', destination)
